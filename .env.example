# Horizons environment variables.
#
# Copy to .env.local for development. Never commit real values: CI refuses
# any build containing a secret or an env file.

# --- Required: Supabase (database + auth) -------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="server-only-never-expose-to-the-browser"

# --- Recommended: canonical app URL (metadata, link previews) ------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Optional: email delivery (Resend) -----------------------------------
# Without these, announcements save but email sending reports unconfigured.
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="Horizons <noreply@example.com>"

# --- Optional: online payments (Paystack) --------------------------------
# Without this, invoices work but Paystack checkout reports unconfigured.
# Use a TEST secret on staging; live secrets only in production.
PAYSTACK_SECRET_KEY="your-paystack-secret-key"
